// Portable collection and UI substitutes surround exact production excerpts.
#include <algorithm>
#include <cassert>
#include <cstdint>
#include <functional>
#include <iostream>
#include <map>
#include <memory>
#include <stdexcept>
#include <string>
#include <vector>
using namespace std;
using POSITION=size_t; using HTREEITEM=void*; using DWORD=uintptr_t;
using UINT=unsigned; using BOOL=bool;
constexpr bool TRUE=true;
constexpr int LVIS_FOCUSED=1,LVIS_SELECTED=2;
#define ASSERT assert
#define ASSERT_VALID(x) assert(x)
#define RUNTIME_CLASS(x) 0
struct CString: string {
  static int live;
  CString(){++live;} CString(const string& s):string(s){++live;}
  CString(const CString& s):string(s){++live;}
  ~CString(){--live;}
  using string::operator=;
  operator const char*() const {return c_str();}
};
int CString::live=0;
uint64_t comparisons=0;
struct CountLess {
  bool operator()(CString* a,CString* b) const {++comparisons;return less<CString*>()(a,b);}
};
template<class It,class T> It counted_find(It first,It last,T value) {
  for(;first!=last;++first){++comparisons;if(*first==value)return first;}
  return last;
}
struct CObject {int value;bool IsKindOf(int){return true;}};
struct ObjectMap {
  map<string,CObject*> items;
  POSITION GetStartPosition(){return items.empty()?0:1;}
  void GetNextAssoc(POSITION& p,CString& key,CObject*& value){auto i=items.begin();advance(i,p-1);key=i->first;value=i->second;p=p<items.size()?p+1:0;}
  bool Lookup(const CString& key,CObject*& value){auto i=items.find(key);if(i==items.end())return false;value=i->second;return true;}
};
struct Control {
  vector<CString*> rows;
  bool failData=false;
  CString* failDeletion=nullptr;
  ~Control(){for(auto* p:rows)delete p;}
  int GetItemCount(){return rows.size();}
  DWORD GetItemData(int n){return reinterpret_cast<DWORD>(rows.at(n));}
  bool SetItemData(int n,DWORD value){if(failData){failData=false;return false;}rows.at(n)=reinterpret_cast<CString*>(value);return true;}
  bool DeleteItem(int n){if(rows.at(n) && rows.at(n)==failDeletion)return false;rows.erase(rows.begin()+n);return true;}
  UINT GetItemState(int,int){return 0;}
  int GetSelectionMark(){return -1;}
  void SetItemState(int,UINT,int){}
  void SetSelectionMark(int){}
};
// Tree paths are compiled but not exercised by these list tests.
struct Tree {
  HTREEITEM GetRootItem(){return nullptr;}
  HTREEITEM GetNextSiblingItem(HTREEITEM){abort();}
  HTREEITEM GetChildItem(HTREEITEM){abort();}
  DWORD GetItemData(HTREEITEM){abort();}
  HTREEITEM GetParentItem(HTREEITEM){abort();}
  bool DeleteItem(HTREEITEM){abort();}
};
struct lua_State {bool keep=true;};
void lua_pushvalue(lua_State*,int){}
void lua_pushstring(lua_State*,const char*){}
int lua_pcall(lua_State*,int,int,int){return 0;}
bool lua_isboolean(lua_State*,int){return true;}
bool lua_toboolean(lua_State* L,int){return L->keep;}
void lua_pop(lua_State*,int){}
void AfxThrowResourceException(){throw runtime_error("resource failure");}
struct CGenPropertyPage {
  Control control; Control* m_ctlList=&control;
  ObjectMap objects; ObjectMap* m_ObjectMap=&objects;
  Tree m_cTreeCtrl; bool m_bWantTreeControl=false; int m_nUpdateNumber=0;
  int failInsertAt=-1,failDescriptionAt=-1,insertions=0;
  bool filterEven=false;
  lua_State state;
  vector<CObject> items;
  void setup(int n){items.resize(n);for(int i=0;i<n;++i){items[i].value=i;string key=to_string(i);objects.items[key]=&items[i];control.rows.push_back(new CString(key));}}
  int AddItem(CObject*,int n,BOOL){int attempt=insertions++;if(attempt==failDescriptionAt)throw runtime_error("description failure");if(attempt==failInsertAt)return -1;control.rows.insert(control.rows.begin()+n,nullptr);return n;}
  void SetModificationNumber(CObject*,int){}
  void CheckParentHasChildren(HTREEITEM){abort();}
  HTREEITEM add_tree_item(CObject*,CString*){abort();}
  void GetFilterInfo(CObject* item,lua_State* L){L->keep=!filterEven || item->value%2==0;}
  void LuaError(lua_State*){throw runtime_error("filter error");}
  int add_list_item(CObject*,const CString*,int,BOOL);
  void Reload(){bool bFiltering=filterEven;lua_State* L=&state;int iCount=0,iNotShown=0;
@REPLACE@
  }
};
@INSERT@
int main(){
  for(int n:{0,1,20})for(bool filtered:{false,true}){
    int live=CString::live;
    {CGenPropertyPage page;page.setup(n);auto old=page.control.rows;page.filterEven=filtered;page.Reload();
     assert(page.control.GetItemCount()==(filtered?(n+1)/2:n));
     for(auto* row:page.control.rows){assert(find(old.begin(),old.end(),row)==old.end());if(filtered)assert(stoi(*row)%2==0);}
    }assert(CString::live==live);
  }
  cout<<"Success: empty, single, filtered, and complete replacements passed\n";
  for(int mode:{0,1,2})for(int count:{0,1,5}){
    int live=CString::live;
    {CGenPropertyPage page;page.setup(10);auto old=page.control.rows;
     if(mode==0)page.failInsertAt=count;
     if(mode==1)page.failDescriptionAt=count;
     if(mode==2){page.control.failData=true;}
     bool caught=false;try{page.Reload();}catch(const runtime_error& e){caught=true;assert(string(e.what())==(mode==1?"description failure":"resource failure"));}
     assert(caught && page.control.rows==old);
     assert(CString::live==live+10);
    }assert(CString::live==live);
  }
  cout<<"Failure: insertion, description, and item-data failures retain old rows and propagate errors\n";
  {CGenPropertyPage page;page.setup(3);auto old=page.control.rows;
   page.control.failDeletion=old.back();bool caught=false;
   try{page.Reload();}catch(const runtime_error& e){caught=string(e.what())=="resource failure";}
   assert(caught && find(page.control.rows.begin(),page.control.rows.end(),old.back())!=page.control.rows.end());
  }
  assert(CString::live==0);
  cout<<"Failure: old-row deletion error remains visible\n";
  for(int n:{100,1000,10000}){
    CGenPropertyPage page;page.setup(n);comparisons=0;page.Reload();
    unsigned levels=1;for(int k=n;k>1;k/=2)++levels;
    cout<<"rows="<<n<<" comparisons="<<comparisons<<endl;
    assert(comparisons<64ULL*n*levels);
    assert(page.control.GetItemCount()==n);
  }
  {CGenPropertyPage page;page.setup(10000);auto old=page.control.rows;
   page.failDescriptionAt=5000;comparisons=0;bool caught=false;
   try{page.Reload();}catch(const runtime_error& e){caught=string(e.what())=="description failure";}
   assert(caught && page.control.rows==old && comparisons<64ULL*10000*14);
   cout<<"large rollback comparisons="<<comparisons<<endl;
  }
  assert(CString::live==0);
  cout<<"Large-list comparison bounds and ownership checks passed\n";
}
