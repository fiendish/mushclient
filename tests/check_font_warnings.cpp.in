#include <algorithm>
#include <cassert>
#include <cctype>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <functional>
#include <iostream>
#include <map>
#include <memory>
#include <set>
#include <stdexcept>
#include <string>
#include <vector>
using namespace std;
using BOOL = int;
using BYTE = unsigned char;
using DWORD = unsigned long;
using LPCTSTR = const char *;
using LPARAM = intptr_t;
using WPARAM = uintptr_t;
using POSITION = void *;
using HMODULE = void *;
constexpr BOOL TRUE = 1, FALSE = 0;
constexpr int DEFAULT_CHARSET = 1, LF_FACESIZE = 32, LOGPIXELSY = 90;
constexpr int HILITE = 1, BLINK = 2, UNDERLINE = 4;
constexpr int FW_NORMAL = 400, FW_BOLD = 700, MUSHCLIENT_FONT_FAMILY = 1;
constexpr int WM_SETFONT = 48, FR_PRIVATE = 0x10;
constexpr long eOK = 0, eNoSuchWindow = 30017, eCannotAddFont = 30065;
constexpr long eFileNotFound = 30012, eNoSuchCommand = 30023, eBadParameter = 30046;
constexpr const char * SCRIPTERRORFORECOLOUR = "orangered";
#define CALLBACK
#define WINAPI
#define NUMITEMS(a) (int(sizeof(a) / sizeof((a)[0])))
#define RUNTIME_CLASS(c) 0
#define MAKELPARAM(a, b) ((a) + (b))

class CString {
    string text;
public:
    CString(const char * value = "") : text(value) {}
    operator LPCTSTR() const { return text.c_str(); }
};
CString TFormat(const char * format, ...) {
    char buffer[2048];
    va_list args;
    va_start(args, format);
    int length = vsnprintf(buffer, sizeof(buffer), format, args);
    va_end(args);
    assert(length >= 0 && length < int(sizeof(buffer)));
    return buffer;
}
@TYPES@
ci_set availableFonts = {"Dina", "Courier New"};
bool dcAvailable = true;
int enumerations = 0;
struct LOGFONT {
    BYTE lfCharSet = 0;
    char lfFaceName[LF_FACESIZE] = {};
    BYTE lfPitchAndFamily = 0;
};
struct TEXTMETRIC { int tmHeight = 12, tmAveCharWidth = 8; };
class CFont {
public:
    void * m_hObject = this;
    template<class... Args> BOOL CreateFont(Args...) { return TRUE; }
};
class CDC {
    CFont stock;
    CFont * selected = &stock;
public:
    BOOL CreateCompatibleDC(void *) { return dcAvailable; }
    CDC * GetSafeHdc() { return this; }
    int GetDeviceCaps(int) { return 96; }
    CFont * SelectObject(CFont * font) {
        CFont * previous = selected;
        selected = font;
        return previous;
    }
    BOOL GetTextMetrics(TEXTMETRIC * metrics) {
        *metrics = TEXTMETRIC();
        return TRUE;
    }
};
int EnumFontFamiliesEx(CDC *, LOGFONT * font,
                      int (*callback)(const LOGFONT *, const TEXTMETRIC *, DWORD, LPARAM),
                      LPARAM param, DWORD flags) {
    ++enumerations;
    assert(font->lfCharSet == DEFAULT_CHARSET);
    assert(font->lfPitchAndFamily == 0 && flags == 0);
    if (availableFonts.count(font->lfFaceName))
        return callback(font, nullptr, 0, param);
    return 1; // The return value alone does not prove a font was found.
}
int MulDiv(double a, int b, int c) { return int(a * b / c); }
[[noreturn]] void AfxThrowResourceException() { throw runtime_error("resource error"); }
class CView {
public:
    bool IsKindOf(int) { return false; }
    void SendMessage(int, WPARAM, int) {}
};
class CMUSHView : public CView { public: void sizewindow() {} };
class CSendView : public CView { public: void AdjustCommandWindowSize() {} };
struct CPlugin { CString m_strName, m_strID; };
class CMiniWindow {
public:
    long result = eOK;
    int requests = 0;
    long Font(LPCTSTR, LPCTSTR, double, BOOL, BOOL, BOOL, BOOL, short, short) {
        ++requests;
        return result;
    }
};
using MiniWindowMap = map<string, CMiniWindow *>;
using MiniWindowMapIterator = MiniWindowMap::iterator;
int loadedFiles = 0;
bool fileAvailable = false;
int AddResource(LPCTSTR, DWORD flags, void * reserved) {
    assert(flags == FR_PRIVATE && !reserved);
    ++loadedFiles;
    return fileAvailable ? 1 : 0;
}
BOOL RemoveResource(LPCTSTR, DWORD, void *) { return TRUE; }
using PAFMR = int (WINAPI *)(LPCTSTR, DWORD, void *);
using PRFMR = BOOL (WINAPI *)(LPCTSTR, DWORD, void *);
PAFMR pAddFontResourceEx = nullptr;
PRFMR pRemoveFontResourceEx = nullptr;
BOOL initialized = FALSE;
HMODULE GetModuleHandle(LPCTSTR) { return reinterpret_cast<HMODULE>(1); }
void * GetProcAddress(HMODULE, LPCTSTR name) {
    if (!strcmp(name, "AddFontResourceExA")) return reinterpret_cast<void *>(&AddResource);
    assert(!strcmp(name, "RemoveFontResourceExA"));
    return reinterpret_cast<void *>(&RemoveResource);
}
class CMUSHclientDoc {
public:
    CPlugin * m_CurrentPlugin = nullptr;
    ci_set m_FontWarnings, m_strSpecialFontName;
    MiniWindowMap m_MiniWindows;
    vector<string> warnings;
    function<void()> onWarning;
    CFont * m_font[16] = {};
    CFont * m_input_font = nullptr;
    int m_FontHeight = 0, m_FontWidth = 0, m_InputFontHeight = 0, m_InputFontWidth = 0;
    ~CMUSHclientDoc() {
        for (CFont * font : m_font) delete font;
        delete m_input_font;
    }
    POSITION GetFirstViewPosition() { return nullptr; }
    CView * GetNextView(POSITION &) { return nullptr; }
    void ColourNote(LPCTSTR, LPCTSTR, LPCTSTR message) {
        warnings.emplace_back(message);
        if (onWarning) onWarning();
    }
    void FontWarning(const CString &);
    void WarnIfFontMissing(LPCTSTR, LPCTSTR);
    void ChangeFont(int, const char *, int, DWORD, BOOL, BOOL, BOOL, unsigned short);
    void ChangeInputFont(int, const char *, int, DWORD, BYTE);
    long WindowFont(LPCTSTR, LPCTSTR, LPCTSTR, double, BOOL, BOOL, BOOL, BOOL, short, short);
    long AddSpecialFont(LPCTSTR);
    long AddFont(LPCTSTR);
};
@METHODS@
void output(CMUSHclientDoc & doc, LPCTSTR name) {
    doc.ChangeFont(10, name, FW_NORMAL, DEFAULT_CHARSET, TRUE, TRUE, TRUE, 0);
}
long mini(CMUSHclientDoc & doc, LPCTSTR name) {
    return doc.WindowFont("window", "font", name, name[0] ? 10 : 0,
                          FALSE, FALSE, FALSE, FALSE, DEFAULT_CHARSET, 0);
}
int main() {
    CPlugin first = {"Map", "first-plugin"}, second = {"Map", "second-plugin"};
    {
        CMUSHclientDoc doc;
        output(doc, "dInA");
        assert(doc.warnings.empty());
        assert(doc.m_FontHeight == 12 && doc.m_FontWidth == 8);
        output(doc, "Missing output");
        assert(doc.warnings.size() == 1);
        assert(doc.warnings[0].find("output font 'Missing output'") != string::npos);
        assert(doc.m_font[0] && doc.m_font[15]);
        output(doc, "");
        assert(doc.warnings.size() == 1);
    }
    {
        CMUSHclientDoc doc;
        doc.m_CurrentPlugin = &first;
        doc.ChangeInputFont(10, "Missing input", FW_NORMAL, DEFAULT_CHARSET, FALSE);
        assert(doc.m_input_font && doc.warnings.size() == 1);
        assert(doc.warnings[0].find("first-plugin") != string::npos);
        doc.m_CurrentPlugin = nullptr;
        doc.ChangeInputFont(10, "Other input", FW_NORMAL, DEFAULT_CHARSET, FALSE);
        assert(doc.warnings.size() == 1);
    }
    {
        CMUSHclientDoc doc;
        CMiniWindow window;
        doc.m_MiniWindows["window"] = &window;
        doc.m_CurrentPlugin = &first;
        assert(mini(doc, "Dina") == eOK && doc.warnings.empty());
        assert(mini(doc, "Missing plugin") == eOK && doc.warnings.size() == 1);
        assert(doc.warnings[0].find("Warning in plugin 'Map' (first-plugin)") != string::npos);
        for (int i = 0; i < 10; ++i) assert(mini(doc, "missing PLUGIN") == eOK);
        assert(doc.warnings.size() == 1 && window.requests == 12);
        doc.m_CurrentPlugin = &second;
        assert(mini(doc, "Missing plugin") == eOK && doc.warnings.size() == 2);
        assert(doc.warnings.back().find("second-plugin") != string::npos);
        assert(mini(doc, "") == eOK && doc.warnings.size() == 2);
        window.result = eCannotAddFont;
        assert(mini(doc, "Broken") == eCannotAddFont && doc.warnings.size() == 3);
        window.result = eBadParameter;
        assert(mini(doc, "Invalid") == eBadParameter && doc.warnings.size() == 3);
        doc.m_MiniWindows.clear();
        assert(mini(doc, "Absent window") == eNoSuchWindow && doc.warnings.size() == 3);
    }
    {
        CMUSHclientDoc doc;
        CMiniWindow window;
        doc.m_CurrentPlugin = &first;
        doc.m_MiniWindows["window"] = &window;
        doc.onWarning = [&] { assert(mini(doc, "Recursive") == eOK); };
        assert(mini(doc, "Recursive") == eOK);
        assert(doc.warnings.size() == 1 && window.requests == 2);
        doc.onWarning = nullptr;
    }
    {
        CMUSHclientDoc doc;
        doc.m_CurrentPlugin = &first;
        assert(doc.AddFont("") == eBadParameter && doc.warnings.empty());
        assert(doc.AddFont("missing.fon") == eFileNotFound && doc.warnings.size() == 1);
        assert(doc.m_strSpecialFontName.empty());
        assert(doc.warnings[0].find("font file 'missing.fon'") != string::npos);
        assert(doc.AddFont("missing.fon") == eFileNotFound && doc.warnings.size() == 1);
        fileAvailable = true;
        assert(doc.AddFont("missing.fon") == eOK);
        assert(doc.m_strSpecialFontName.count("missing.fon") == 1);
        int before = loadedFiles;
        assert(doc.AddFont("missing.fon") == eOK && loadedFiles == before);
        availableFonts.insert("Loaded later");
        doc.WarnIfFontMissing("Loaded later", "miniwindow");
        assert(doc.warnings.size() == 1);
    }
    {
        CMUSHclientDoc doc;
        int before = enumerations;
        doc.WarnIfFontMissing(string(LF_FACESIZE, 'x').c_str(), "output");
        assert(enumerations == before && doc.warnings.size() == 1);
        dcAvailable = false;
        doc.WarnIfFontMissing("Check failure", "output");
        assert(doc.warnings.size() == 2);
        assert(doc.warnings.back().find("Unable to check") != string::npos);
        dcAvailable = true;
    }
    cout << "Font warning, return-code, and reentry checks passed.\n";
}
